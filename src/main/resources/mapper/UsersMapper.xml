<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.pan.demo.mapper.UsersMapper">
    <select id="login" resultType="users">
        SELECT * FROM t_sys_user WHERE account = #{account} AND PASSWORD = #{password}
    </select>

    <select id="query" resultType="users">
        SELECT * FROM t_sys_user
        <where>
            <if test="account!=null and account!=''">
                account LIKE CONCAT('%',#{account},'%')
            </if>
        </where>
    </select>

    <delete id="delete" parameterType="string">
        DELETE FROM t_sys_user WHERE id = #{id}
    </delete>

    <insert id="insert" parameterType="users">
        INSERT INTO `t_sys_user` (
            `account`,
            `realName`,
            `password`,
            `sex`,
            `birthday`,
            `address`,
            `roleId`,
            `createdTime`
        )
        VALUES
            (
                #{account},
                #{realName},
                #{password},
                #{sex},
                #{birthday},
                #{address},
                #{roleId},
                now()
            )
    </insert>
</mapper>